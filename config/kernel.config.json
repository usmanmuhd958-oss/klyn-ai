{
  "name": "klyn-ai-os",
  "version": "3.1.0",
  "environment": "production",
  "baseDir": "${HOME}/klyn-ai-os",

  "log": {
    "level": "info",
    "dir": "${HOME}/klyn-ai-os/runtime/logs",
    "maxFileSize": 52428800,
    "maxFiles": 10
  },

  "mailbox": {
    "pollMs": 100,
    "cleanupIntervalMs": 3600000
  },

  "health": {
    "intervalMs": 30000,
    "metricsIntervalMs": 5000
  },

  "watchdog": {
    "intervalMs": 30000,
    "missThreshold": 3
  },

  "shutdown": {
    "drainTimeoutMs": 30000,
    "forceTimeoutMs": 10000
  },

  "agents": [
    {
      "id":              "planner",
      "type":            "planner",
      "script":          "agents/src/planner.sh",
      "autoStart":       true,
      "required":        false,
      "maxRestarts":     5,
      "restartDelay":    200,
      "gracefulTimeout": 15000,
      "memoryLimitMb":   256,
      "env": { "AGENT_ROLE": "planner" }
    },
    {
      "id":              "coder",
      "type":            "coder",
      "script":          "agents/src/coder.sh",
      "autoStart":       true,
      "required":        false,
      "maxRestarts":     5,
      "restartDelay":    200,
      "gracefulTimeout": 15000,
      "memoryLimitMb":   512,
      "env": { "AGENT_ROLE": "coder" }
    },
    {
      "id":              "reviewer",
      "type":            "reviewer",
      "script":          "agents/src/reviewer.sh",
      "autoStart":       true,
      "required":        false,
      "maxRestarts":     5,
      "restartDelay":    200,
      "gracefulTimeout": 15000,
      "memoryLimitMb":   256,
      "env": { "AGENT_ROLE": "reviewer" }
    },
    {
      "id":              "bug-hunter",
      "type":            "security",
      "script":          "agents/src/proactive_bug_hunter.sh",
      "autoStart":       false,
      "required":        false,
      "maxRestarts":     3,
      "restartDelay":    500,
      "gracefulTimeout": 10000,
      "memoryLimitMb":   128,
      "env": {
        "AGENT_ROLE":        "bug-hunter",
        "KLYN_PROJECT_ROOT": "${HOME}/klyn-ai-os"
      }
    }
  ]
}
