import * as dotenv from 'dotenv';
import { execSync } from 'child_process';
import * as fs from 'fs';
import * as path from 'path';

dotenv.config();

export class BrainRouter {
  private selectedModel: string;
  private keys: Record<string, string>;

  constructor() {
    this.selectedModel = process.env.AI_MODEL || 'fable-5';
    this.keys = {
      ANTHROPIC_API_KEY: process.env.ANTHROPIC_API_KEY || '',
      OPENAI_API_KEY: process.env.OPENAI_API_KEY || '',
      GOOGLE_API_KEY: process.env.GOOGLE_API_KEY || '',
      DEEPSEEK_API_KEY: process.env.DEEPSEEK_API_KEY || ''
    };

    const envPath = path.resolve(process.cwd(), '.env');
    if (fs.existsSync(envPath)) {
      const envConfig = dotenv.parse(fs.readFileSync(envPath));
      if (!this.keys.ANTHROPIC_API_KEY) this.keys.ANTHROPIC_API_KEY = envConfig.ANTHROPIC_API_KEY || '';
      if (!this.keys.OPENAI_API_KEY) this.keys.OPENAI_API_KEY = envConfig.OPENAI_API_KEY || '';
      if (!this.keys.GOOGLE_API_KEY) this.keys.GOOGLE_API_KEY = envConfig.GOOGLE_API_KEY || '';
      if (!this.keys.DEEPSEEK_API_KEY) this.keys.DEEPSEEK_API_KEY = envConfig.DEEPSEEK_API_KEY || '';
    }
  }

  private sleep(ms: number): Promise<void> {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  private executeCurl(command: string): any {
    const rawOutput = execSync(command, { encoding: 'utf-8', timeout: 30000 });
    return JSON.parse(rawOutput);
  }

  private callAnthropic(prompt: string): string {
    const apiKey = this.keys.ANTHROPIC_API_KEY;
    const payload = JSON.stringify({
      model: 'claude-fable-5-2026',
      max_tokens: 4000,
      messages: [{ role: 'user', content: prompt }]
    });

    const command = `curl -s https://api.anthropic.com/v1/messages \
      -H "x-api-key: ${apiKey}" \
      -H "anthropic-version: 2023-06-01" \
      -H "content-type: application/json" \
      -d '${payload.replace(/'/g, "'\\''")}'`;

    const response = this.executeCurl(command);
    if (response?.content?.[0]?.text) {
      return response.content[0].text;
    }
    throw new Error(`Anthropic error: ${JSON.stringify(response)}`);
  }

  private callOpenAI(prompt: string): string {
    const apiKey = this.keys.OPENAI_API_KEY;
    const payload = JSON.stringify({
      model: 'gpt-5.6-sol',
      messages: [{ role: 'user', content: prompt }]
    });

    const command = `curl -s https://api.openai.com/v1/chat/completions \
      -H "Authorization: Bearer ${apiKey}" \
      -H "content-type: application/json" \
      -d '${payload.replace(/'/g, "'\\''")}'`;

    const response = this.executeCurl(command);
    if (response?.choices?.[0]?.message?.content) {
      return response.choices[0].message.content;
    }
    throw new Error(`OpenAI error: ${JSON.stringify(response)}`);
  }

  private callGoogle(prompt: string): string {
    const apiKey = this.keys.GOOGLE_API_KEY;
    const payload = JSON.stringify({
      contents: [{ parts: [{ text: prompt }] }]
    });

    const command = `curl -s "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-pro:generateContent?key=${apiKey}" \
      -H "content-type: application/json" \
      -d '${payload.replace(/'/g, "'\\''")}'`;

    const response = this.executeCurl(command);
    if (response?.candidates?.[0]?.content?.parts?.[0]?.text) {
      return response.candidates[0].content.parts[0].text;
    }
    throw new Error(`Google error: ${JSON.stringify(response)}`);
  }

  private callDeepSeek(prompt: string): string {
    const apiKey = this.keys.DEEPSEEK_API_KEY;
    const payload = JSON.stringify({
      model: 'deepseek-v4-pro',
      messages: [{ role: 'user', content: prompt }]
    });

    const command = `curl -s https://api.deepseek.com/v1/chat/completions \
      -H "Authorization: Bearer ${apiKey}" \
      -H "content-type: application/json" \
      -d '${payload.replace(/'/g, "'\\''")}'`;

    const response = this.executeCurl(command);
    if (response?.choices?.[0]?.message?.content) {
      return response.choices[0].message.content;
    }
    throw new Error(`DeepSeek error: ${JSON.stringify(response)}`);
  }

  public async queryBrain(prompt: string): Promise<string> {
    const maxRetries = 3;
    let attempt = 0;

    while (attempt < maxRetries) {
      attempt++;
      try {
        switch (this.selectedModel) {
          case 'gpt-5.6':
            return this.callOpenAI(prompt);
          case 'gemini-3.5':
            return this.callGoogle(prompt);
          case 'deepseek-v4':
            return this.callDeepSeek(prompt);
          case 'fable-5':
          default:
            return this.callAnthropic(prompt);
        }
      } catch (error: any) {
        if (attempt >= maxRetries) {
          throw new Error(`BrainRouter failed after ${maxRetries} attempts. Last error: ${error.message}`);
        }
        await this.sleep(Math.pow(2, attempt) * 1000);
      }
    }
    throw new Error('BrainRouter query failed unexpectedly.');
  }
}

export const brainRouter = new BrainRouter();

export async function queryBrain(prompt: string): Promise<string> {
  return brainRouter.queryBrain(prompt);
}

export default queryBrain;

