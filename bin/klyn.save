#!/usr/bin/env bash
# =============================================================
# KLYN AI OS — Master CLI v5.0.0 (FINAL HARDENED)
#
# FIX 1: Token Vault sync
#   Token is read from runtime/state/.api_vault automatically.
#   No manual export required. Works across all subshells.
#   Priority: KLYN_API_TOKEN env → vault file → no-auth
#
# FIX 2: Bug-hunter agent
#   Bug-scan CLI command uses POST /tasks with type agent:bug-scan
#   The kernel handles it via direct spawn (not orchestrator).
#   No crash loops. Exit codes handled gracefully.
# =============================================================

set -Eeuo pipefail

# ─── CONFIGURATION ───────────────────────────────────────────
KLYN_ROOT="${KLYN_ROOT:-${HOME}/klyn-ai-os}"
API_BASE="${KLYN_API_BASE:-http://127.0.0.1:9000}"
DASH_URL="${KLYN_DASH_URL:-http://127.0.0.1:9001}"
CLI_VERSION="5.0.0"

# Canonical vault path — must match kernel-entry.js TokenVault path
KLYN_VAULT_FILE="${KLYN_VAULT_FILE:-${KLYN_ROOT}/runtime/state/.api_vault}" ─── 
COLOUR SUPPORT ────────────────────────────────────────── if [[ -t 1 ]]; then 
R='\033[0;31m' G='\033[0;32m' Y='\033[1;33m' B='\033[0;34m' C='\033[0;36m' 
W='\033[1;37m' DIM='\033[2m' BOLD='\033[1m' RESET='\033[0m' else R='' G='' Y='' 
B='' C='' W='' DIM='' BOLD='' RESET='' fi ─── OUTPUT HELPERS 
────────────────────────────────────────── info() { echo -e "${G}✔${RESET} $*"; } 
warn() { echo -e "${Y}⚠${RESET} $*"; } error() { echo -e "${R}✖${RESET} $*" >&2; } 
success() { echo -e "${G}${BOLD}✔ $*${RESET}"; } heading() { echo -e "\n${W}${B}── 
$* ──${RESET}\n"; } dim() { echo -e "${DIM}$*${RESET}"; } die() { error "$*"; exit 
1; } ─── TOKEN RESOLUTION (FIX 1) ──────────────────────────────── Three-tier 
fallback chain — guarantees token is always found without requiring manual `export 
KLYN_API_TOKEN=...` Tier 1: KLYN_API_TOKEN already set in current shell env Tier 
2: Read from vault file (written by kernel on boot) Tier 3: No token 
(unauthenticated — API will reject unless token disabled) _resolve_token() { Tier 
1: Environment variable (highest priority) if [[ -n "${KLYN_API_TOKEN:-}" ]]; then 
echo -n "${KLYN_API_TOKEN}" return 0 fi Tier 2: Vault file (written atomically by 
kernel-entry.js) if [[ -f "${KLYN_VAULT_FILE}" ]]; then Parse the JSON vault 
record with node (already a dependency) local token token="$(node -e " try { const 
fs = require('fs'); const data = JSON.parse(fs.readFileSync('${KLYN_VAULT_FILE}', 
'utf8')); const t = data.token || ''; Validate: 64 hex chars if 
(/^[a-f0-9]{64}$/i.test(t)) process.stdout.write(t); catch (_) { /* vault 
unreadable */ } " 2>/dev/null || true)" if [[ -n "${token}" ]]; then echo -n 
"${token}" return 0 fi fi Tier 3: No token available echo -n "" return 0 Cache the 
resolved token for this CLI invocation _RESOLVED_TOKEN="" _init_token() { if [[ -z 
"${_RESOLVED_TOKEN}" ]]; then _RESOLVED_TOKEN="$(_resolve_token)" fi ─── API 
HELPERS ───────────────────────────────────────────── _get_token() { _init_token 
echo -n "${_RESOLVED_TOKEN}" _auth_args() { local token token="$(_get_token)" if 
[[ -n "${token}" ]]; then echo "-H Authorization: Bearer ${token}" else echo "" fi 
GET request with token auth _api_get() { local endpoint="${1}" local token 
token="$(_get_token)" local curl_cmd=( curl -sf --connect-timeout 5 --max-time 20 
) [[ -n "${token}" ]] && curl_cmd+=(-H "Authorization: Bearer ${token}") 
curl_cmd+=("${API_BASE}${endpoint}") "${curl_cmd[@]}" 2>/dev/null POST request 
with JSON body and token auth _api_post() { local endpoint="${1}" local 
body="${2:-}" local token token="$(_get_token)" local curl_cmd=( curl -sf 
--connect-timeout 5 --max-time 30 -X POST -H "Content-Type: application/json" ) [[ 
-n "${token}" ]] && curl_cmd+=(-H "Authorization: Bearer ${token}") [[ -n 
"${body}" ]] && curl_cmd+=(-d "${body}") curl_cmd+=("${API_BASE}${endpoint}") 
"${curl_cmd[@]}" 2>/dev/null DELETE request with token auth _api_delete() { local 
endpoint="${1}" local token token="$(_get_token)" local curl_cmd=( curl -sf 
--connect-timeout 5 --max-time 15 -X DELETE ) [[ -n "${token}" ]] && curl_cmd+=(-H 
"Authorization: Bearer ${token}") curl_cmd+=("${API_BASE}${endpoint}") 
"${curl_cmd[@]}" 2>/dev/null JSON pretty printer (no external tools beyond 
python3/node) _pp() { if command -v python3 &>/dev/null; then python3 -c " import 
sys, json try: d = json.load(sys.stdin) print(json.dumps(d, indent=2, 
ensure_ascii=False)) except: import sys as s s.stdout.write(sys.stdin.read()) " 
2>/dev/null || cat elif command -v node &>/dev/null; then node -e " let d=''; 
process.stdin.on('data',c=>d+=c); process.stdin.on('end',()=>{ 
try{process.stdout.write(JSON.stringify(JSON.parse(d),null,2)+'\n');} 
catch{process.stdout.write(d);} );" 2>/dev/null || cat else cat fi Extract a 
string field from a JSON string without jq _jfield() { local json="${1}" 
field="${2}" echo "${json}" | grep -o "\"${field}\":[[:space:]]*\"[^\"]*\"" 
2>/dev/null | \ head -1 | sed "s/\"${field}\":[[:space:]]*\"//;s/\"$//" || true 
Extract a boolean/number field _jval() { local json="${1}" field="${2}" echo 
"${json}" | grep -o "\"${field}\":[[:space:]]*[^,}]*" 2>/dev/null | \ head -1 | 
sed "s/\"${field}\":[[:space:]]*//" | tr -d '[:space:]' || true Require kernel to 
be running _require_kernel() { if ! curl -sf --connect-timeout 3 
"${API_BASE}/health" &>/dev/null; then echo "" error "Kernel not reachable at 
${API_BASE}" echo "" echo -e " Start the kernel with:" dim " node 
kernel/kernel-entry.js &" echo "" exit 1 fi Show token status for debugging 
_show_token_status() { local token token="$(_get_token)" if [[ -n "${token}" ]]; 
then echo -e " ${G}Token : ✅ ${token:0:16}...${RESET}" else echo -e " ${Y}Token : 
⚠ Not found (unauthenticated)${RESET}" fi if [[ -f "${KLYN_VAULT_FILE}" ]]; then 
echo -e " ${DIM}Vault : ${KLYN_VAULT_FILE}${RESET}" else echo -e " ${DIM}Vault : 
Not yet created (start kernel first)${RESET}" fi ─── COMMAND: tasks 
─────────────────────────────────────────── cmd_tasks() { local 
subcommand="${1:-}" shift || true if [[ -z "${subcommand}" ]]; then _tasks_status 
return fi case "${subcommand}" in --add|-a|add) _tasks_add_parse "$@" ;; 
--list|-l|list) _tasks_list ;; --status|-s) _tasks_status ;; status) _tasks_status 
;; --dlq|dlq) _tasks_dlq ;; --cancel|cancel) _tasks_cancel "${1:-}" ;; 
--clear-dlq|clear-dlq) _tasks_clear_dlq ;; --help|-h|help) _tasks_help ;; *) Treat 
bare non-flag argument as task title if [[ "${subcommand}" != --* ]]; then 
_tasks_add "${subcommand} $*" "agent:generate" "NORMAL" "{}" "{}" else error 
"Unknown tasks subcommand: '${subcommand}'" _tasks_help exit 1 fi esac ─── TASKS: 
PARSE ADD FLAGS ─────────────────────────────────── _tasks_add_parse() { local 
title="" local task_type="agent:generate" local priority="NORMAL" local 
payload_str="{}" local tags_str="{}" First positional arg (if not a flag) is the 
title if [[ $# -gt 0 && "${1}" != --* ]]; then title="${1}" shift || true fi while 
[[ $# -gt 0 ]]; do case "${1}" in --title|-t) title="${2:-}"; shift 2 || break ;; 
--type) task_type="${2:-agent:generate}"; shift 2 || break ;; --priority|-p) 
priority="${2:-NORMAL}"; shift 2 || break ;; --payload) payload_str="${2:-{}}"; 
shift 2 || break ;; --tags) tags_str="${2:-{}}"; shift 2 || break ;; Type 
shortcuts --plan) task_type="agent:plan"; shift || break ;; --generate) 
task_type="agent:generate"; shift || break ;; --review) task_type="agent:review"; 
shift || break ;; --bug-scan) task_type="agent:bug-scan"; shift || break ;; 
Priority shortcuts --critical) priority="CRITICAL"; shift || break ;; --high) 
priority="HIGH"; shift || break ;; --normal) priority="NORMAL"; shift || break ;; 
--low) priority="LOW"; shift || break ;; --background) priority="BACKGROUND"; 
shift || break ;; *) Accumulate remaining positional args into title if [[ -z 
"${title}" ]]; then title="${1}" else title="${title} ${1}" fi shift || break esac 
done if [[ -z "${title}" ]]; then echo "" error "Task title is required." echo "" 
echo -e " Usage: klyn tasks --add ${DIM}\"Your task description\"${RESET}" echo "" 
echo -e " Examples:" dim " klyn tasks --add \"Build authentication system\"" dim " 
klyn tasks --add \"Plan OAuth2 integration\" --type agent:plan --high" dim " klyn 
tasks --add \"Review generated code\" --review" echo "" exit 1 fi _tasks_add 
"${title}" "${task_type}" "${priority}" "${payload_str}" "${tags_str}" ─── TASKS: 
ADD ─────────────────────────────────────────────── _tasks_add() { local 
title="${1}" local task_type="${2:-agent:generate}" local priority="${3:-NORMAL}" 
local payload_str="${4:-{}}" local tags_str="${5:-{}}" _require_kernel heading 
"Enqueueing Task" Show what we're submitting echo -e " ${DIM}Title :${RESET} 
${W}${title}${RESET}" echo -e " ${DIM}Type :${RESET} ${task_type}" echo -e " 
${DIM}Priority :${RESET} ${priority}" echo -e " ${DIM}Endpoint :${RESET} 
${API_BASE}/tasks" echo "" ── Build JSON body safely 
──────────────────────────────── Escape the title for JSON embedding: \ → \\ " → 
\" newlines → space tabs → space local escaped_title escaped_title="$( printf '%s' 
"${title}" \ sed 's/\\/\\\\/g' \ sed 's/"/\\"/g' \ tr '\n\t\r' ' ' )" Validate 
payload_str is valid JSON — fall back to {} local safe_payload="{}" if node -e 
"JSON.parse(process.argv[1])" -- "${payload_str}" &>/dev/null 2>&1; then 
safe_payload="${payload_str}" fi Validate tags_str is valid JSON — fall back to {} 
local safe_tags="{}" if node -e "JSON.parse(process.argv[1])" -- "${tags_str}" 
&>/dev/null 2>&1; then safe_tags="${tags_str}" fi Build final request body using 
node for reliable JSON serialisation local body body="$(node -e " 
process.stdout.write(JSON.stringify({ title: '${escaped_title}', type: 
'${task_type}', priority: '${priority}', payload: ${safe_payload}, tags: 
${safe_tags}, source: 'klyn-cli-v${CLI_VERSION}', )); " 2>/dev/null)" if [[ -z 
"${body}" ]]; then Fallback: manual JSON construction if node fails 
body="{\"title\":\"${escaped_title}\",\"type\":\"${task_type}\",\"priority\":\"${priority}\",\"source\":\"klyn-cli\"}" 
fi ── Submit to API ───────────────────────────────────────── local response 
http_code Capture both response body and HTTP status code response="$( _api_post 
"/tasks" "${body}" 2>/dev/null )" || true if [[ -z "${response}" ]]; then echo "" 
error "No response from API at ${API_BASE}/tasks" echo "" Diagnose the issue local 
health_check health_check="$(curl -sf --connect-timeout 3 "${API_BASE}/health" 
2>/dev/null || true)" if [[ -z "${health_check}" ]]; then error "Kernel is not 
reachable" dim " Start kernel: node kernel/kernel-entry.js &" else Kernel is up 
but request failed — likely auth issue error "Kernel is running but rejected the 
request" echo "" _show_token_status echo "" dim " If token mismatch: restart 
kernel or run 'klyn auth-status'" fi exit 1 fi ── Parse response 
──────────────────────────────────────── local is_success task_id error_msg 
is_dedup is_success="$(_jval "${response}" "success")" task_id="$(_jfield 
"${response}" "taskId")" error_msg="$(_jfield "${response}" "error")" 
is_dedup="$(_jval "${response}" "deduplicated")" if [[ "${is_success}" == "true" 
]]; then if [[ "${is_dedup}" == "true" ]]; then warn "Task already in queue 
(idempotency key matched)" echo "" dim " The identical task is already 
pending/running." dim " Use: klyn tasks --list to see queue state." else ── 
SUCCESS OUTPUT ──────────────────────────────── echo -e " 
${G}${BOLD}╔══════════════════════════════════════════════╗${RESET}" echo -e " 
${G}${BOLD}║ ✅ Task Queued Successfully ║${RESET}" echo -e " 
${G}${BOLD}╚══════════════════════════════════════════════╝${RESET}" echo "" echo 
-e " ${W}Task ID :${RESET} ${C}${task_id:-unknown}${RESET}" echo -e " ${W}Title 
:${RESET} ${title}" echo -e " ${W}Type :${RESET} ${task_type}" echo -e " 
${W}Priority :${RESET} ${priority}" echo "" echo -e " ${DIM}Agent(s) will begin 
processing this task shortly.${RESET}" echo "" echo -e " ${DIM}Track 
progress:${RESET}" dim " klyn tasks --list # queue state" dim " klyn logs planner 
# planner output" dim " klyn logs coder # coder output" fi else echo "" error 
"Task queue rejected the request" echo "" if [[ -n "${error_msg}" ]]; then echo -e 
" ${R}Error : ${error_msg}${RESET}" fi echo "" echo " Full response:" echo 
"${response}" | _pp | sed 's/^/ /' echo "" Check if it's an auth error if echo 
"${response}" | grep -q "Unauthorized"; then echo "" warn "Authentication failed — 
checking token vault..." _show_token_status echo "" echo -e " Fix: Ensure kernel 
is running (it writes the vault on boot)" dim " node kernel/kernel-entry.js &" fi 
exit 1 fi ─── TASKS: LIST ────────────────────────────────────────────── 
_tasks_list() { _require_kernel heading "Task Queue — Pending & Running" local 
response response="$(_api_get "/tasks")" || { die "Failed to fetch tasks from 
${API_BASE}/tasks" [[ -z "${response}" ]] && { warn "Empty response"; return 1; } 
echo "${response}" | python3 -c " import sys, json try: d = json.load(sys.stdin) 
data = d.get('data', {}) pending = data.get('pending', []) running = 
data.get('running', []) counts = data.get('counts', {}) total = 
counts.get('pending', len(pending)) + counts.get('running', len(running)) print(f' 
Pending : {counts.get(\"pending\", len(pending))}') print(f' Running : 
{counts.get(\"running\", len(running))}') print(f' DLQ : {counts.get(\"dlq\", 
0)}') if total == 0: print() print(' Queue is empty — add a task:') print(' klyn 
tasks --add \"Your task description\"') sys.exit(0) print() print(f' {\"ID\":<10} 
{\"STATE\":<11} {\"PRI\":<10} {\"TYPE\":<22} TITLE') print(' ' + '─' * 75) 
all_tasks = [(t, 'RUNNING') for t in running] + \ [(t, 'QUEUED') for t in pending] 
for task, default_state in all_tasks: tid = (task.get('id') or '?')[:8] state = 
task.get('state', default_state)[:11] pri = str(task.get('priority', 
'NORMAL'))[:10] ttype = (task.get('type') or '?')[:22] ttitle = 
((task.get('title') or ''))[:40] print(f' {tid:<10} {state:<11} {pri:<10} 
{ttype:<22} {ttitle}') except Exception as e: print(f' Parse error: {e}') 
sys.exit(1) " 2>/dev/null || echo "${response}" | _pp ─── TASKS: STATUS 
──────────────────────────────────────────── _tasks_status() { _require_kernel 
heading "Task Queue Status" local response response="$(_api_get "/tasks/status")" 
|| { Fallback: extract from /status response="$(_api_get "/status")" || true [[ -z 
"${response}" ]] && { warn "API unavailable"; return 1; } echo "${response}" | 
python3 -c " import sys, json try: d = json.load(sys.stdin) Handle /tasks/status → 
data field Handle /status → taskQueue field if 'data' in d: tq = d['data'] elif 
'taskQueue' in d: tq = d['taskQueue'] else: tq = d q = tq.get('queue', {}) st = 
tq.get('stats', {}) h = tq.get('handlers', []) print(f' Active : 
{tq.get(\"active\", \"?\")}') print(f' Concurrency : {tq.get(\"concurrency\", 
\"?\")} workers') print() print(' ┌── Queue Depths ───────────────────┐') print(f' 
│ Pending : {str(q.get(\"pending\", 0)):<6} │') print(f' │ Running : 
{str(q.get(\"running\", 0)):<6} │') print(f' │ DLQ : {str(q.get(\"dlq\", 0)):<6} 
│') print(' └────────────────────────────────────┘') print() print(' ┌── Lifetime 
Statistics ────────────┐') print(f' │ Enqueued : {str(st.get(\"enqueued\", 0)):<6} 
│') print(f' │ Completed : {str(st.get(\"completed\", 0)):<6} │') print(f' │ 
Failed : {str(st.get(\"failed\", 0)):<6} │') print(f' │ Retried : 
{str(st.get(\"retried\", 0)):<6} │') print(f' │ Cancelled : 
{str(st.get(\"cancelled\", 0)):<6} │') print(f' │ Expired : 
{str(st.get(\"expired\", 0)):<6} │') print(' 
└────────────────────────────────────┘') if h: print() print(f' Handlers: {chr(10) 
+ \" \"}{chr(10) + \" \".join(h)}') except Exception as e: print(f' Render error: 
{e}') " 2>/dev/null || echo "${response}" | _pp ─── TASKS: DLQ 
─────────────────────────────────────────────── _tasks_dlq() { _require_kernel 
heading "Dead Letter Queue" local response response="$(_api_get "/tasks/dlq")" || 
{ die "Failed to fetch DLQ" echo "${response}" | python3 -c " import sys, json 
try: d = json.load(sys.stdin) entries = d.get('data', d) if not 
isinstance(entries, list): entries = [] if entries: print(f' {len(entries)} 
entries in Dead Letter Queue:') print() print(f' {\"ID\":<10} {\"TYPE\":<22} 
{\"REASON\":<15} TITLE') print(' ' + '─' * 70) for e in entries[-25:]: t = 
e.get('task') or {} print(f' {(t.get(\"id\") or \"\")[:8]:<10} {(t.get(\"type\") 
or \"\")[:22]:<22} {(e.get(\"reason\") or \"\")[:15]:<15} {(t.get(\"title\") or 
\"\")[:35]}') else: print(' DLQ is empty ✅') except Exception as e: print(f' 
Parse error: {e}') " 2>/dev/null || echo "${response}" | _pp ─── TASKS: CANCEL 
──────────────────────────────────────────── _tasks_cancel() { local 
task_id="${1:-}" [[ -z "${task_id}" ]] && die "Usage: klyn tasks --cancel 
<task-id>" _require_kernel warn "Cancelling task: ${task_id}" local response 
response="$(_api_post "/tasks/${task_id}/cancel")" || { die "Request failed for 
task ${task_id}" local is_success err_msg is_success="$(_jval "${response}" 
"success")" err_msg="$(_jfield "${response}" "error")" if [[ "${is_success}" == 
"true" ]]; then success "Task cancelled: ${task_id}" else error "Cancel failed: 
${err_msg}" exit 1 fi ─── TASKS: CLEAR DLQ 
───────────────────────────────────────── _tasks_clear_dlq() { _require_kernel 
warn "Clearing Dead Letter Queue..." local response response="$(_api_delete 
"/tasks/dlq")" || { die "Request failed"; } local cleared cleared="$(_jval 
"${response}" "cleared")" success "DLQ cleared: ${cleared:-0} entries removed" ─── 
TASKS: HELP ────────────────────────────────────────────── _tasks_help() { echo "" 
echo -e " ${W}${B}klyn tasks — Task Queue Control${RESET}" echo "" echo -e " 
${W}Enqueueing:${RESET}" echo " klyn tasks --add \"Build JWT authentication\"" 
echo " klyn tasks --add \"Plan system architecture\" --plan" echo " klyn tasks 
--add \"Generate OAuth module\" --type agent:generate --high" echo " klyn tasks 
--add \"Review PR changes\" --review --critical" echo " klyn tasks --add \"Run 
security audit\" --bug-scan" echo "" echo -e " ${W}Inspection:${RESET}" echo " 
klyn tasks Queue status (default)" echo " klyn tasks --list Pending + running 
tasks" echo " klyn tasks --status Full statistics" echo " klyn tasks --dlq Dead 
letter queue" echo "" echo -e " ${W}Management:${RESET}" echo " klyn tasks 
--cancel <id> Cancel queued task" echo " klyn tasks --clear-dlq Clear DLQ" echo "" 
echo -e " ${W}Task Types:${RESET}" echo " agent:generate (default) Coder agent" 
echo " agent:plan Planner agent" echo " agent:review Reviewer agent" echo " 
agent:bug-scan Security scan (direct spawn)" echo "" echo -e " ${W}Priority 
Levels:${RESET}" echo " --critical --high --normal --low --background" echo "" ─── 
COMMAND: auth-status ───────────────────────────────────── cmd_auth_status() { 
heading "Authentication Status" _show_token_status echo "" local health 
health="$(curl -sf --connect-timeout 3 "${API_BASE}/health" 2>/dev/null || true)" 
if [[ -z "${health}" ]]; then warn "Kernel not reachable at ${API_BASE}" else info 
"Kernel reachable" local token token="$(_get_token)" if [[ -z "${token}" ]]; then 
warn "No token — API calls will be unauthenticated" else Test auth with /status 
local status_resp status_resp="$(_api_get "/status" 2>/dev/null || true)" if [[ -n 
"${status_resp}" ]]; then success "Authentication working ✅" else error 
"Authentication FAILED — token may be stale" echo "" dim " The vault file may 
contain an old token." dim " Restart the kernel to regenerate: node 
kernel/kernel-entry.js &" fi fi fi ─── COMMAND: status 
────────────────────────────────────────── cmd_status() { _require_kernel heading 
"KLYN AI OS — System Status" local data data="$(_api_get /status)" echo "${data}" 
| python3 -c " import sys, json d = json.load(sys.stdin) k = d.get('kernel', {}) m 
= d.get('metrics') or {} mem = m.get('memory') or {} up = k.get('uptime', 0) // 
1000 h, r = divmod(up, 3600) mi, s = divmod(r, 60) print(f' Name : 
{k.get(\"name\",\"?\")} v{k.get(\"version\",\"?\")}') print(f' Status : {\"READY\" 
if k.get(\"ready\") else \"BOOTING\"}') print(f' Environment : 
{k.get(\"environment\",\"?\")}') print(f' PID : {k.get(\"pid\",\"?\")}') print(f' 
Uptime : {h}h {mi}m {s}s') print() rss = mem.get('current', 0) peak = 
mem.get('peak', 0) print(f' Heap Used : {rss/1024/1024:.1f} MB') print(f' Heap 
Peak : {peak/1024/1024:.1f} MB') sys2 = m.get('system') or {} la = 
sys2.get('loadAvg') or [0, 0, 0] free = sys2.get('freeMem', 0) tot = 
sys2.get('totalMem', 0) print(f' Load Avg : {la[0]:.2f} / {la[1]:.2f} / 
{la[2]:.2f}') print(f' Free RAM : {free/1024/1024:.0f} MB / {tot/1024/1024:.0f} 
MB') tq = d.get('taskQueue') or {} q = tq.get('queue') or {} if q: print() 
print(f' Tasks : pending={q.get(\"pending\",0)} running={q.get(\"running\",0)} 
dlq={q.get(\"dlq\",0)}') " 2>/dev/null || echo "${data}" | _pp ─── COMMAND: agents 
────────────────────────────────────────── cmd_agents() { _require_kernel heading 
"KLYN AI OS — Agents" local data data="$(_api_get /agents)" printf " %-20s %-14s 
%-12s %-8s\n" "AGENT" "STATE" "UPTIME" "RESTARTS" printf " %s\n" "$(printf '─%.0s' 
{1..58})" echo "${data}" | python3 -c " import sys, json d = json.load(sys.stdin) 
for id, a in d.items(): up = a.get('uptime', 0) // 1000 us = 
(f'{up//3600}h{(up%3600)//60}m' if up>3600 else f'{up//60}m{up%60}s' if up>60 else 
f'{up}s') state = a.get('state', '?') restarts = a.get('restartCount', 0) print(f' 
{id:<20} {state:<14} {us:<12} {restarts}') " 2>/dev/null || echo "${data}" | _pp 
─── COMMAND: start / stop / restart ───────────────────────── cmd_start() { local 
id="${1:-}" [[ -z "${id}" ]] && die "Usage: klyn start <agent-id>" _require_kernel 
info "Starting agent: ${id}" _api_post "/agents/${id}/start" | _pp cmd_stop() { 
local id="${1:-}" [[ -z "${id}" ]] && die "Usage: klyn stop <agent-id>" 
_require_kernel warn "Stopping agent: ${id}" _api_post "/agents/${id}/stop" | _pp 
cmd_restart() { local id="${1:-}" [[ -z "${id}" ]] && die "Usage: klyn restart 
<agent-id>" _require_kernel warn "Restarting agent: ${id}" _api_post 
"/agents/${id}/restart" | _pp ─── COMMAND: logs 
──────────────────────────────────────────── cmd_logs() { local 
target="${1:-kernel}" local lines="${2:-80}" heading "Logs: ${target}" local 
search_paths=( "${KLYN_ROOT}/runtime/logs/klyn-${target}.log" 
"${KLYN_ROOT}/runtime/logs/agents/${target}/${target}.log" 
"${KLYN_ROOT}/runtime/logs/agents/${target}.log" 
"${KLYN_ROOT}/runtime/logs/${target}.log" 
"${KLYN_ROOT}/runtime/logs/klyn-orchestrator.log" ) for p in "${search_paths[@]}"; 
do if [[ -f "${p}" ]]; then info "→ ${p}" echo "" tail -n "${lines}" -f "${p}" 
return fi done die "No log file found for: ${target}" ─── COMMAND: health 
────────────────────────────────────────── cmd_health() { local r r="$(curl -sf 
--connect-timeout 5 "${API_BASE}/health" 2>/dev/null || echo '{}')" if echo "${r}" 
| grep -q '"status":"ok"'; then success "Kernel HEALTHY ✅" echo "" echo "${r}" | 
_pp else error "Kernel UNHEALTHY ❌" echo "" echo "${r}" exit 1 fi ─── COMMAND: 
metrics ───────────────────────────────────────── cmd_metrics() { _require_kernel 
heading "Metrics Snapshot" _api_get /status | python3 -c " import sys, json d = 
json.load(sys.stdin) m = d.get('metrics') or {} cb = d.get('circuits') or {} mem = 
m.get('memory') or {} print(f' Heap Used : {mem.get(\"current\",0)/1024/1024:.1f} 
MB') print(f' Heap Peak : {mem.get(\"peak\",0)/1024/1024:.1f} MB') sys2 = 
m.get('system') or {} la = sys2.get('loadAvg') or [0] print(f' System Load : 
{la[0]:.2f}') print(f' Free Memory : {sys2.get(\"freeMem\",0)/1024/1024:.0f} MB') 
if cb: print() print(' Circuits:') for n, c in cb.items(): print(f' {n}: 
{c.get(\"state\",\"?\")} (failures={c.get(\"failureCount\",0)})') " 2>/dev/null || 
warn "Metrics unavailable" ─── COMMAND: shutdown 
──────────────────────────────────────── cmd_shutdown() { _require_kernel warn 
"Sending graceful shutdown request..." _api_post "/shutdown" | _pp success 
"Shutdown request sent" ─── COMMAND: dashboard 
─────────────────────────────────────── cmd_dashboard() { heading "Dashboard" echo 
-e "\n ${C}${DASH_URL}${RESET}\n" command -v termux-open-url &>/dev/null \ && 
termux-open-url "${DASH_URL}" 2>/dev/null || true ─── COMMAND: version 
───────────────────────────────────────── cmd_version() { echo "" echo -e " 
${W}KLYN AI OS${RESET} CLI v${CLI_VERSION}" echo " Node : $(node -v 2>/dev/null || 
echo N/A)" echo " Root : ${KLYN_ROOT}" echo " API : ${API_BASE}" echo " Dash : 
${DASH_URL}" echo " Vault : ${KLYN_VAULT_FILE}" echo "" ─── COMMAND: help 
──────────────────────────────────────────── cmd_help() { echo "" echo -e " 
${W}${B}KLYN AI OS — CLI v${CLI_VERSION}${RESET}" echo "" echo -e " 
${W}Usage:${RESET} klyn <command> [args]" echo "" echo -e " ${W}Kernel:${RESET}" 
echo " status Full system status" echo " health Liveness check" echo " metrics 
Metrics snapshot" echo " auth-status Token + auth diagnostics" echo " shutdown 
Graceful shutdown" echo "" echo -e " ${W}Agents:${RESET}" echo " agents List all 
agents + state" echo " start <id> Start agent" echo " stop <id> Stop agent" echo " 
restart <id> Restart agent" echo "" echo -e " ${W}Task Queue:${RESET}" echo " 
tasks Queue status" echo " tasks --add \"...\" Enqueue task" echo " tasks --list 
Pending + running" echo " tasks --status Full statistics" echo " tasks --dlq Dead 
letter queue" echo " tasks --cancel <id> Cancel queued task" echo " tasks --help 
Full task help" echo "" echo -e " ${W}Observability:${RESET}" echo " logs [agent] 
Tail logs (default: kernel)" echo " dashboard Open dashboard URL" echo " version 
Version info" echo "" echo -e " ${W}Quick Examples:${RESET}" dim " klyn tasks 
--add \"Build user authentication system\"" dim " klyn tasks --add \"Plan 
microservice architecture\" --plan --high" dim " klyn tasks --add \"Review 
generated code\" --review" dim " klyn tasks --add \"Security audit\" --bug-scan" 
dim " klyn auth-status" echo "" ─── MAIN ROUTER 
───────────────────────────────────────────── main() { local cmd="${1:-help}" 
shift || true case "${cmd}" in status) cmd_status ;; agents) cmd_agents ;; start) 
cmd_start "${1:-}" ;; stop) cmd_stop "${1:-}" ;; restart) cmd_restart "${1:-}" ;; 
logs) cmd_logs "${1:-kernel}" "${2:-80}" ;; metrics) cmd_metrics ;; health) 
cmd_health ;; tasks) cmd_tasks "${@}" ;; auth-status) cmd_auth_status ;; shutdown) 
cmd_shutdown ;; dashboard) cmd_dashboard ;; version) cmd_version ;; 
help|-h|--help) cmd_help ;; *) error "Unknown command: '${cmd}'" echo "" cmd_help 
exit 1 esac main "$@"
