#!/usr/bin/env bash
ROOT="$HOME/klyn-ai-os"
ACTION="${1:-list}"
CLIENT_ID="${2:-}"
PLAN="${3:-pro}"
EXPIRES="${4:-2027-01-01T00:00:00Z}"
MODELS="${5:-local}"

case "$ACTION" in
  add)
    node -e "
      const { upsertClient } = require('$ROOT/kernel/src/services/subscription_manager');
      upsertClient('$CLIENT_ID', '$PLAN', '$EXPIRES', '$MODELS'.split(','));
      console.log('Client $CLIENT_ID added/updated.');
    "
    ;;
  rm)
    node -e "
      const { removeClient } = require('$ROOT/kernel/src/services/subscription_manager');
      removeClient('$CLIENT_ID');
      console.log('Client $CLIENT_ID removed.');
    "
    ;;
  list)
    node -e "
      const fs = require('fs');
      const data = fs.readFileSync('$ROOT/runtime/clients.json','utf8');
      console.log(JSON.stringify(JSON.parse(data), null, 2));
    "
    ;;
  *)
    echo "Usage: klyn-client {add|rm|list} [id] [plan] [expires] [models]"
    ;;
esac
