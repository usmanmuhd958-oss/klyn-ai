#!/usr/bin/env bash
set -euo pipefail

ROOT="${KLYN_ROOT:-$HOME/klyn-ai-os}"
CLIENTS_FILE="$ROOT/runtime/clients.json"
ACTION="${1:-list}"
CLIENT_ID="${2:-}"
PLAN="${3:-pro}"
EXPIRES="${4:-2027-01-01T00:00:00Z}"
MODELS="${5:-local}"

if ! command -v jq &>/dev/null; then
    echo "jq is required. Install it with: pkg install jq"
    exit 1
fi

mkdir -p "$(dirname "$CLIENTS_FILE")"

case "$ACTION" in
  add)
    tmpfile="${CLIENTS_FILE}.tmp.$$"
    if [ -f "$CLIENTS_FILE" ]; then
        jq --arg id "$CLIENT_ID" --arg plan "$PLAN" --arg expires "$EXPIRES" --arg models "$MODELS" \
           '.[$id] = { plan: $plan, expiresAt: $expires, allowed_models: ($models | split(",")) }' \
           "$CLIENTS_FILE" > "$tmpfile"
    else
        jq -n --arg id "$CLIENT_ID" --arg plan "$PLAN" --arg expires "$EXPIRES" --arg models "$MODELS" \
           '{($id): { plan: $plan, expiresAt: $expires, allowed_models: ($models | split(",")) }}' \
           > "$tmpfile"
    fi
    mv "$tmpfile" "$CLIENTS_FILE"
    echo "Client $CLIENT_ID added/updated."
    ;;
  rm)
    if [ -f "$CLIENTS_FILE" ]; then
        tmpfile="${CLIENTS_FILE}.tmp.$$"
        jq "del(.[\"$CLIENT_ID\"])" "$CLIENTS_FILE" > "$tmpfile"
        mv "$tmpfile" "$CLIENTS_FILE"
        echo "Client $CLIENT_ID removed."
    else
        echo "No clients file found."
    fi
    ;;
  list)
    if [ -f "$CLIENTS_FILE" ]; then
        jq '.' "$CLIENTS_FILE"
    else
        echo "{}"
    fi
    ;;
  *)
    echo "Usage: klyn-client {add|rm|list} [id] [plan] [expires] [models]"
    exit 1
    ;;
esac
