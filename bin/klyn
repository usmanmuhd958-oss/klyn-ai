#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$HOME/klyn-ai-os"
cd "$ROOT"

source kernel/init.sh

cmd="${1:-help}"
sub="${2:-}"

case "$cmd" in
    service)
        case "$sub" in
            start) start_service "$3" "kernel/services/${3}.sh" ;;
            stop) stop_service "$3" ;;
            restart)
                stop_service "$3"
                start_service "$3" "kernel/services/${3}.sh"
                ;;
            status) service_status "$3" ;;
            deps) start_with_deps "$3" ;;
            ls) list_services ;;
            *) echo "klyn service {start|stop|restart|status|deps|ls}" ;;
        esac
        ;;

    agent)
        case "$sub" in
            ls) list_agents ;;
            register) register_agent "$3" "$4" ;;
            show) agent_status "$3" ;;
            *) echo "klyn agent {ls|register|show}" ;;
        esac
        ;;

    metrics)
        metrics_export
        ;;

    health)
        health_check_service "${2:-scheduler}"
        ;;

    snapshot)
        snapshot_state
        ;;

    doctor)
        echo "=== KLYN Doctor ==="
        metrics_export
        ;;

    *)
        cat <<USAGE
klyn service start <name>
klyn service stop <name>
klyn service restart <name>
klyn service status <name>
klyn service deps <name>
klyn service ls

klyn agent ls
klyn agent register <name> <model>
klyn agent show <name>

klyn metrics
klyn health [service]
klyn snapshot
klyn doctor
USAGE
        ;;
esac
