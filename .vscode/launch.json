{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "API Server",
      "program": "${workspaceFolder}/api/server.js",
      "env": { "PORT": "3000" }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Health Check",
      "program": "${workspaceFolder}/scripts/health_check.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Coder Agent",
      "program": "${workspaceFolder}/agents/src/coder.sh",
      "args": ["Create a password generator"]
    }
  ]
}
