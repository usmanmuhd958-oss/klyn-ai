# KLYN backend environment contract
# Never commit real credentials. Inject secrets through the deployment secret store.

NODE_ENV=development
HOST=127.0.0.1
PORT=7860

# Required backend secrets
JWT_SECRET=<generate-a-random-secret-at-least-32-characters>
ADMIN_PASSWORD=<set-a-strong-admin-password>

# Database / Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=<public-anon-key-if-needed-by-server>
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>

# AI providers (server-only)
OPENAI_API_KEY=<secret>
ANTHROPIC_API_KEY=<secret>
GEMINI_API_KEY=<secret>
