# KLYN OS server environment contract
# All values are placeholders. Inject real credentials from a secret manager.
# Never commit .env or expose server-only values through browser bundles.

NODE_ENV=development
HOST=127.0.0.1
PORT=7860

# Application authentication; generate distinct values per environment.
JWT_SECRET=<generate-a-random-secret-at-least-32-characters>
ADMIN_PASSWORD=<set-a-strong-admin-password>

# Direct PostgreSQL connection (5432): migrations, schema diff, administration.
# URL-encode reserved characters in passwords.
DATABASE_URL=postgresql://postgres:<URL_ENCODED_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres

# Supavisor transaction pooler (typically 6543): short app queries only.
# Do not use for migrations/session-affine transactions.
DATABASE_TRANSACTION_URL=postgresql://postgres.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@<POOLER_HOST>:6543/postgres?pgbouncer=true

SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<public-anon-key-if-needed-for-server-side-user-auth>

# SERVER-ONLY. Bypasses ordinary RLS safeguards; never expose to browser/client code.
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>

# Optional provider credentials: configure only enabled providers.
OPENAI_API_KEY=<secret>
ANTHROPIC_API_KEY=<secret>
GEMINI_API_KEY=<secret>
DEEPSEEK_API_KEY=<secret>
OPENROUTER_API_KEY=<secret>
GROQ_API_KEY=<secret>
TOGETHER_API_KEY=<secret>
FIREWORKS_API_KEY=<secret>
MISTRAL_API_KEY=<secret>
COHERE_API_KEY=<secret>
REPLICATE_API_TOKEN=<secret>

# Optional local/self-hosted inference endpoints.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
VLLM_BASE_URL=http://127.0.0.1:8000/v1
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
