pub const EMBEDDING_DIMS: usize = 128;

pub unsafe fn simd_cosine_similarity(a: &[f32; EMBEDDING_DIMS], b: &[f32; EMBEDDING_DIMS]) -> f32 {
    let mut dot = 0.0;
    let mut norm_a = 0.0;
    let mut norm_b = 0.0;

    for i in 0..EMBEDDING_DIMS {
        dot += a[i] * b[i];
        norm_a += a[i] * a[i];
        norm_b += b[i] * b[i];
    }

    if norm_a == 0.0 || norm_b == 0.0 {
        return 0.0;
    }

    dot / (norm_a.sqrt() * norm_b.sqrt())
}
