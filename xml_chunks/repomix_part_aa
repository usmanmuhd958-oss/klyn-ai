  private countPythonASTNodes(content: string): number {
    let count = 0;
    
    const patterns = [
      /\bdef\b/g,
      /\bclass\b/g,
      /\bif\b/g,
      /\belif\b/g,
      /\belse\b/g,
      /\bfor\b/g,
