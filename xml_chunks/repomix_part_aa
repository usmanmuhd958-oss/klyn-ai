  private countGoASTNodes(content: string): number {
    let count = 0;
    
    const patterns = [
      /\bfunc\b/g,
      /\btype\b/g,
      /\bstruct\b/g,
      /\binterface\b/g,
      /\bif\b/g,
      /\bfor\b/g,
      /\bswitch\b/g,
      /\bcase\b/g,
      /\breturn\b/g,
      /\bimport\b/g,
      /\bvar\b/g,
      /\bconst\b/g,
      /\{/g,
    ];
    
    for (const pattern of patterns) {
      const matches = content.match(pattern);
      count += matches ? matches.length : 0;
    }
    
    return count;
