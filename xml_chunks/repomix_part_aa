# -- Helper: read a value from the user ------------------------------------
read_secret() {
    local prompt="$1"
    local varname="$2"
    local default="${3:-}"
    local input
    read -r -p "$prompt: " input
    input="${input:-$default}"
    eval "$varname='$input'"
}

