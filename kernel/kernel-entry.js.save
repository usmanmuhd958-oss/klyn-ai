
// ============================================================
// KLYN AI OS — Kernel Entry Point v1.0.0
//
// Boots orchestrator + health API together.
// Writes PID file. Validates config before spawning anything.
// ============================================================

'use strict';

const path = require('path');
const fs   = require('fs');

const { createOrchestrator } = require('./orchestrator');
const { HealthApiServer }    = require('./health-api');
const { createLogger }       = require('./logger');

async function main() {
    const CONFIG_PATH = process.env.KLYN_CONFIG
        || path.join(process.cwd(), 'config', 'kernel.config.json');

    if (!fs.existsSync(CONFIG_PATH)) {
        console.error(`\n  ❌  Config not found: ${CONFIG_PATH}\n`);
        process.exit(1);
    }

    const config      = JSON.parse(fs.readFileSync(CONFIG_PATH, 'utf8'));
    const orchestrator = createOrchestrator(config);

    // Boot logger for entry point
    const logger = createLogger({
        name:    'klyn-kernel-entry',
        level:   config.log?.level || 'info',
        logDir:  config.log?.dir || path.join(config.baseDir, 'runtime', 'logs'),
        console: true,
    });

    // Write PID file
    const pidPath = path.join(config.baseDir, 'runtime', 'state', 'kernel.pid');
    try {
        fs.mkdirSync(path.dirname(pidPath), { recursive: true });
        fs.writeFileSync(pidPath, String(process.pid), 'utf8');
        logger.info(`PID written: ${process.pid} → ${pidPath}`);
    } catch (err) {
        logger.warn(`Could not write PID file: ${err.message}`);
    }

    // Health API
    const healthPort = parseInt(process.env.KLYN_HEALTH_PORT || '9000', 10);
    const healthApi  = new HealthApiServer(orchestrator, logger, {
        port:      healthPort,
        rateLimit: 100,
    });

    orchestrator.on('ready', async ({ bootMs }) => {
        console.log(`\n  ✅  KLYN AI OS READY — boot: ${bootMs}ms\n`);
        console.log(`  📡  Health API  → http://127.0.0.1:${healthPort}/health`);
        console.log(`  📊  Status API  → http://127.0.0.1:${healthPort}/status`);
        console.log(`  🔧  Agents API  → http://127.0.0.1:${healthPort}/agents\n`);

        try {
            await healthApi.listen();
        } catch (err) {
            logger.warn(`Health API failed to start: ${err.message}`);
        }
    });

    orchestrator.on('shutdown-complete', async () => {
        await healthApi.close().catch(() => {});
        try { fs.unlinkSync(pidPath); } catch (_) {}
    });

    orchestrator.on('agent-failed', ({ id }) => {
        logger.error(`Agent permanently failed: ${id}`);
    });

    orchestrator.on('bug-found', (payload) => {
        logger.warn('Bug alert', payload);
    });

    try {
        await orchestrator.boot();
    } catch (err) {
        logger.fatal(`Kernel failed to boot: ${err.message}`);
        try { fs.unlinkSync(pidPath); } catch (_) {}
        process.exit(1);
    }
}

main();
