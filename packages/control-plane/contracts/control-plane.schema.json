{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KLYN Control Plane Contracts v1",
  "$defs": {
    "Uuid": { "type": "string", "format": "uuid" },
    "Hash256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "MissionState": { "enum": ["INTENT_CAPTURED", "ENVELOPE_DEFINED", "PLAN_GENERATED", "ACTION_EXECUTED", "ARTIFACT_PRODUCED", "AUTOMATED_VERIFICATION", "HUMAN_APPROVAL", "PRODUCTION_ROLLOUT_AUDITED"] },
    "BreakerLevel": { "enum": ["NONE", "SOFT_HALT", "EXECUTION_HALT", "MISSION_HALT", "TENANT_HALT"] },
    "CreateMissionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "policyId", "objective", "constraints", "idempotencyKey"],
      "properties": {
        "tenantId": { "$ref": "#/$defs/Uuid" },
        "policyId": { "$ref": "#/$defs/Uuid" },
        "objective": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "idempotencyKey": { "type": "string", "minLength": 16, "maxLength": 128 }
      }
    },
    "TransitionMissionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missionId", "fromState", "toState", "expectedVersion", "authorizationToken", "idempotencyKey"],
      "properties": {
        "missionId": { "$ref": "#/$defs/Uuid" },
        "fromState": { "$ref": "#/$defs/MissionState" },
        "toState": { "$ref": "#/$defs/MissionState" },
        "expectedVersion": { "type": "string", "pattern": "^[0-9]+$" },
        "authorizationToken": { "type": "string", "minLength": 16 },
        "idempotencyKey": { "type": "string", "minLength": 16, "maxLength": 128 },
        "payload": { "type": ["object", "array", "string", "number", "boolean", "null"] }
      }
    },
    "CredentialRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionId", "provider", "requestedScopes", "audience", "ttlSeconds"],
      "properties": {
        "executionId": { "$ref": "#/$defs/Uuid" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 256 },
        "requestedScopes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "audience": { "type": "string", "minLength": 1, "maxLength": 512 },
        "ttlSeconds": { "type": "integer", "minimum": 1, "maximum": 900 }
      }
    },
    "ResourceEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelopeId", "missionId", "executionId", "issuedAt", "expiresAt", "tokenBudget", "computeBudget", "latencyBudget", "allowedCapabilities", "networkPolicy", "signature"],
      "properties": {
        "envelopeId": { "$ref": "#/$defs/Uuid" },
        "missionId": { "$ref": "#/$defs/Uuid" },
        "executionId": { "$ref": "#/$defs/Uuid" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "tokenBudget": {
          "type": "object", "additionalProperties": false,
          "required": ["inputMax", "outputMax", "totalMax"],
          "properties": {
            "inputMax": { "type": "string", "pattern": "^[0-9]+$" },
            "outputMax": { "type": "string", "pattern": "^[0-9]+$" },
            "totalMax": { "type": "string", "pattern": "^[0-9]+$" }
          }
        },
        "computeBudget": { "type": "object" },
        "latencyBudget": { "type": "object" },
        "allowedCapabilities": { "type": "array", "items": { "type": "string" } },
        "networkPolicy": { "type": "object" },
        "signature": { "type": "string", "minLength": 1 }
      }
    }
  }
}
