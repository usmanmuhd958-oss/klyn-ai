{
  "name": "klyn-ai-os",
  "version": "1.0.0",
  "description": "Enterprise-grade AI development platform with self-healing capabilities",
  "main": "kernel/orchestrator.js",
  "engines": {
    "node": ">=14.0.0"
  },
  "scripts": {
    "start": "node --expose-gc index.js",
    "dev": "LOG_LEVEL=DEBUG node --expose-gc index.js",
