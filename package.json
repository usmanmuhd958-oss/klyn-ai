{
  "name": "klyn",
  "version": "5.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "dev": "pnpm --filter @klyn/backend dev",
    "start": "pnpm --filter @klyn/backend start",
    "lockfile:generate": "pnpm install --lockfile-only",
    "lockfile:verify": "pnpm install --frozen-lockfile"
  },
  "devDependencies": {
    "@babel/types": "^7.28.4",
    "turbo": "^2.5.6",
    "typescript": "^5.9.3"
  }
}
