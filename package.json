{
  "name": "klyn-ai-os",
  "version": "4.2.0",
  "type": "module",
  "description": "Autonomous AI Operating System surpassing traditional IDEs",
  "main": "klyn_server.js",
  "bin": {
    "klyn": "./klyn_cli.js"
  },
  "scripts": {
    "start": "node klyn_server.js",
    "dev": "node klyn_server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:v670": "tsc --noEmit -p genesis/v670/tsconfig.json",
    "smoke:v670": "bun run genesis/v670/smoke.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.6.3"
  }
}
