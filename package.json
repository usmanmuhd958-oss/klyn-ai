{
  "name": "klyn",
  "version": "6.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "pnpm --recursive --workspace-concurrency=2 --if-present run build",
    "typecheck": "pnpm --recursive --workspace-concurrency=2 --if-present run typecheck",
    "test": "pnpm --recursive --workspace-concurrency=2 --if-present run test",
    "lint": "eslint packages/agent-governance packages/autonomy packages/governance packages/runtime packages/mission-engine packages/execution-runtime packages/cognitive-engine packages/ai-engine apps/backend --max-warnings 0",
    "dev": "pnpm --filter @klyn/backend dev",
    "start": "pnpm --filter @klyn/backend start",
    "vercel-build": "pnpm --filter @klyn/backend run build",
    "lockfile:generate": "pnpm install --lockfile-only",
    "lockfile:verify": "pnpm install --frozen-lockfile",
    "verify:build": "bash scripts/verify-pnpm11-build.sh"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@eslint/js": "^9.35.0",
    "@types/bun": "^1.2.20",
    "@types/node": "^24.0.0",
    "@types/sql.js": "^1.4.9",
    "eslint": "^9.35.0",
    "sql.js": "^1.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.67.0",
    "@google/generative-ai": "^0.24.1",
    "openai": "^7.4.0"
  }
}
