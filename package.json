{
  "name": "klyn-ai-os",
  "version": "4.2.0",
  "type": "module",
  "description": "Autonomous AI Operating System surpassing traditional IDEs",
  "main": "klyn_server.js",
  "bin": {
    "klyn": "./klyn_cli.js"
  },
  "scripts": {
    "start": "node klyn_server.js",
    "dev": "node klyn_server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:v670": "tsc --noEmit -p genesis/v670/tsconfig.json",
    "smoke:v670": "bun run genesis/v670/smoke.ts",
    "smoke:phase3": "bun run packages/self-healing-runtime/smoke.ts",
    "smoke:phase4": "bun run 1.brain/smoke.phase4.ts",
    "smoke:phase5": "bun run 1.brain/smoke.phase5.ts",
    "smoke:phase6": "bun run 1.brain/smoke.phase6.ts",
    "smoke:phase7": "bun run 1.brain/smoke.phase7.ts",
    "smoke:phase8": "bun run 1.brain/smoke.phase8.ts",
    "genesis:forge": "node genesis/forge.mjs all",
    "genesis:verify": "node genesis/forge.mjs verify",
    "genesis:typecheck": "tsc --noEmit -p genesis/tsconfig.json",
    "genesis:test": "bun run genesis/evolution.ts"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@google/generative-ai": "^0.24.1",
    "chokidar": "^5.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3"
  }
}
