{
  "name": "klyn-ai-os",
  "version": "4.2.0",
  "type": "module",
  "description": "Autonomous AI Operating System surpassing traditional IDEs",
  "main": "klyn_server.js",
  "bin": {
    "klyn": "./klyn_cli.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "server:legacy": "node klyn_server.js",
    "build:backend": "tsc -p tsconfig.backend.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:backend": "tsc --noEmit -p tsconfig.backend.json",
    "typecheck:v670": "tsc --noEmit -p genesis/v670/tsconfig.json",
    "smoke:v670": "bun run genesis/v670/smoke.ts",
    "genesis:forge": "node genesis/forge.mjs all",
    "genesis:verify": "node genesis/forge.mjs verify",
    "genesis:typecheck": "tsc --noEmit -p genesis/tsconfig.json",
    "genesis:test": "bun run genesis/evolution.ts"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-sql": "^6.10.0",
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.3",
    "chokidar": "^5.0.0",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "openai": "^7.4.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.9.3"
  }
}
