    "kernel": "node kernel/orchestrator.js",
    "agent:test": "node agents/bug_hunter.js",
    "deploy": "bash tools/deploy_enterprise_core.sh",
    "dry-run": "bash tools/autonomous_dry_run.sh"
  },
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "self-healing",
    "enterprise",
    "termux",
    "android"
  ],
  "author": "KLYN AI Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/auth-js": "^2.110.5",
    "@supabase/postgrest-js": "^2.110.5",
    "@supabase/realtime-js": "^2.110.5",
    "@supabase/storage-js": "^2.110.5",
    "@supabase/supabase-js": "^2.110.5",
    "ajv": "^8.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^14.0.1",
    "ws": "^8.21.1",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31"
  },
  "repository": {
