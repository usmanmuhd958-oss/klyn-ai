+/** Drop every entry whose id starts with `prefix` (used by incremental
+ *  re-indexing so stale per-file blocks are replaced, not duplicated). */
+export function removeMemoryPrefix(prefix) {
+  if (!prefix) return;
+  for (const id of memoryMap.keys()) {
+    if (id.startsWith(prefix)) {
+      memoryMap.delete(id);
+      normCache.delete(id);
+    }
+  }
+  // An append-only log cannot express deletions: flush pending appends,
+  // then rewrite the full state so removals are durable on disk.
+  flushNow();
+  compact();
+}
+
+export function memoryCount() {
+  return memoryMap.size;
+}
+
+// ---------------------------------------------------------------------------
+// Persistence plumbing
+// ---------------------------------------------------------------------------
+
+function scheduleFlush() {
+  if (persistTimer) return;
+  persistTimer = setTimeout(() => {
+    persistTimer = null;
+    flushNow();
+  }, FLUSH_DEBOUNCE_MS);
+}
+
+function flushNow() {
+  const file = persistFilePath();
+  if (!file || pendingWrites.length === 0) return;
+
+  const batch = pendingWrites;
+  pendingWrites = [];
+
+  try {
+    // Fast path: append batch to the log.
+    let chunk = '';
+    for (const entry of batch) {
+      const isBuffer = Buffer.isBuffer(entry.payload);
+      const rec = {
+        id: entry.id,
+        namespace: entry.namespace,
+        embedding: Array.from(entry.embedding),
+        payload: entry.payload
+          ? (isBuffer ? entry.payload.toString('base64') : String(entry.payload))
+          : null,
+        payloadEncoding: isBuffer ? 'base64' : 'utf8',
+        tags: entry.tags || [],
+      };
+      chunk += JSON.stringify(rec) + '\n';
+    }
+    fs.appendFileSync(file, chunk, 'utf8');
+    persistedBytes += chunk.length;
+
+    // Slow path: compact when the log grows large.
+    if (persistedBytes > COMPACT_BYTES) {
+      compact();
+    }
+  } catch {
+    // Persistence must never break the in-memory engine.
+  }
+}
+
+function compact() {
+  const file = persistFilePath();
+  if (!file) return;
+  try {
+    let chunk = '';
+    for (const entry of memoryMap.values()) {
+      const isBuffer = Buffer.isBuffer(entry.payload);
+      chunk += JSON.stringify({
+        id: entry.id,
+        namespace: entry.namespace,
+        embedding: Array.from(entry.embedding),
+        payload: entry.payload
+          ? (isBuffer ? entry.payload.toString('base64') : String(entry.payload))
+          : null,
+        payloadEncoding: isBuffer ? 'base64' : 'utf8',
+        tags: entry.tags || [],
+      }) + '\n';
+    }
+    const tmpFile = file + '.tmp.' + process.pid + '.' + Date.now();
+    fs.writeFileSync(tmpFile, chunk, 'utf8');
+    fs.renameSync(tmpFile, file);
+    persistedBytes = chunk.length;
+  } catch {
+    // Non-fatal: the log stays valid, compaction retries on next trigger.
+  }
+}
+
+// Best-effort durability on shutdown (sync — safe in exit handlers).
+process.on('exit', () => {
+  if (persistTimer) {
+    clearTimeout(persistTimer);
+    persistTimer = null;
+  }
+  flushNow();
+});
