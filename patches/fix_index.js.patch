+/** Minimal binary min-heap used for bounded top-K selection. */
+class MinHeap {
+  constructor(capacity) {
+    this.capacity = capacity;
+    this.items = [];
+  }
+  get size() {
+    return this.items.length;
+  }
+  peek() {
+    return this.items[0];
+  }
+  push(item) {
+    const arr = this.items;
+    arr.push(item);
+    let i = arr.length - 1;
+    while (i > 0) {
+      const parent = (i - 1) >> 1;
+      if (arr[parent].similarity <= arr[i].similarity) break;
+      const tmp = arr[parent];
+      arr[parent] = arr[i];
+      arr[i] = tmp;
+      i = parent;
+    }
+    if (arr.length > this.capacity) this.pop();
+  }
+  pop() {
+    const arr = this.items;
+    const top = arr[0];
+    const last = arr.pop();
+    if (arr.length > 0) {
+      arr[0] = last;
+      let i = 0;
+      const n = arr.length;
+      for (;;) {
+        const l = 2 * i + 1;
+        const r = l + 1;
+        let smallest = i;
+        if (l < n && arr[l].similarity < arr[smallest].similarity) smallest = l;
+        if (r < n && arr[r].similarity < arr[smallest].similarity) smallest = r;
+        if (smallest === i) break;
+        const tmp = arr[smallest];
+        arr[smallest] = arr[i];
+        arr[i] = tmp;
+        i = smallest;
+      }
+    }
+    return top;
+  }
+  sortedDesc() {
+    return this.items.slice().sort((a, b) => b.similarity - a.similarity);
+  }
