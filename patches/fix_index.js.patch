 import path from 'node:path';
 
 const memoryMap = new Map();
+/** Cache of per-entry L2 norms so recall does not recompute them per query. */
+const normCache = new Map();
+
+let vaultDir = null;
+let persistTimer = null;
+let pendingWrites = [];
+let persistedBytes = 0;
+
+const PERSIST_FILE = 'memory.jsonl';
+/** Rewrite the whole file (atomic tmp+rename) once the log exceeds this size. */
+const COMPACT_BYTES = 64 * 1024 * 1024;
+/** Debounce window for batching appends (ms). */
+const FLUSH_DEBOUNCE_MS = 50;
 
 export function initializeVault(vaultPath) {
+  vaultDir = vaultPath;
   if (!fs.existsSync(vaultPath)) {
     fs.mkdirSync(vaultPath, { recursive: true });
   }
+  loadFromDisk();
+}
+
+function persistFilePath() {
+  return vaultDir ? path.join(vaultDir, PERSIST_FILE) : null;
+}
+
+function loadFromDisk() {
+  memoryMap.clear();
+  normCache.clear();
+  const file = persistFilePath();
+  if (!file || !fs.existsSync(file)) return;
+  try {
+    const raw = fs.readFileSync(file, 'utf8');
+    persistedBytes = raw.length;
+    for (const line of raw.split('\n')) {
+      if (!line) continue;
+      try {
+        const rec = JSON.parse(line);
+        if (rec && typeof rec.id === 'string' && rec.embedding) {
+          if (Array.isArray(rec.embedding)) {
+            rec.embedding = Float32Array.from(rec.embedding);
+          }
+          if (rec.payload !== null && rec.payload !== undefined) {
+            // Payloads were stored as Buffers; restore them so consumers can
+            // keep calling payload.toString('utf8').
