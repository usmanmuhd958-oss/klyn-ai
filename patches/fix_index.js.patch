+    // Unreadable vault is not fatal — start empty.
+  }
+}
+
+function computeNorm(embedding) {
+  if (!embedding) return 0;
+  let norm = 0;
+  for (let i = 0; i < embedding.length; i++) norm += embedding[i] * embedding[i];
+  return Math.sqrt(norm);
