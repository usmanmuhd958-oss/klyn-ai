{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@klyn/agent-runtime": [
        "packages/agent-runtime/src/index.ts"
      ],
      "@klyn/agent-runtime/*": [
        "packages/agent-runtime/src/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src/**/*",
    "kernel/**/*",
    "1.brain/**/*",
    "benchmark/**/*",
    "packages/**/*.ts",
    "packages/evolution-controller/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "1.brain/index.ts",
    "1.brain/providers/**/*",
    "1.brain/graph_memory.ts",
    "kernel/src/indexer/**/*",
    "kernel/src/orchestrator/**/*",
    "kernel/src/pipeline/context_pruner.ts",
    "kernel/NexusKernel.ts",
    "kernel/tests/**/*"
  ]
}
